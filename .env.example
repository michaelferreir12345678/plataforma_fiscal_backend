# === Banco de dados ===
# Variáveis consumidas pelo Docker Compose. Use senhas longas e URL-encode os caracteres
# reservados se repetir essas senhas dentro das URLs abaixo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha-do-postgres
POSTGRES_DB=plataforma_fiscal
POSTGRES_PORT=5432

# URL de runtime da API (role de aplicação, SEM superuser, sujeito a RLS)
DATABASE_URL=postgresql+psycopg2://plataforma_app:troque-esta-senha-da-role@localhost:5432/plataforma_fiscal
# URL administrativa (superuser) usada por migrations, bootstrap e seed
DATABASE_ADMIN_URL=postgresql+psycopg2://postgres:troque-esta-senha-do-postgres@localhost:5432/plataforma_fiscal

# Nome do banco e da role de aplicação (usados pelo bootstrap)
DB_NAME=plataforma_fiscal
APP_DB_ROLE=plataforma_app
APP_DB_PASSWORD=troque-esta-senha-da-role

# === Auth / JWT ===
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Redis/RQ (fila de ingestão — Sprint 24) ===
REDIS_URL=redis://localhost:6379/0
# true: desenvolvimento local sem processo RQ separado; false: Docker/produção com worker.
# O docker-compose força false na API e executa o worker como serviço independente.
INGEST_WORKER_IN_PROCESS=true

# === App ===
APP_ENV=local

# === Fontes oficiais de enriquecimento (Sprint 11) ===
SIOPS_BASE_URL=https://siops-consulta-publica-api.saude.gov.br/v1/
SIOPE_BASE_URL=https://www.fnde.gov.br/olinda-ide/servico/DADOS_ABERTOS_SIOPE/versao/v1/odata/
TESOURO_TRANSFERENCIAS_BASE_URL=https://apiapex.tesouro.gov.br/aria/v1/transferencias_constitucionais/custom/

# === IA / Assistente (Sprint 17) - Google Gemini (porta LLMProvider) ===
# Sem chave, o assistente usa o provedor local deterministico (offline).
GEMINI_API_KEY=
ASSISTANT_PROVIDER=auto
ASSISTANT_CHAT_MODEL=gemini-2.5-flash
ASSISTANT_SUMMARY_MODEL=gemini-2.5-pro
ASSISTANT_EMBEDDING_MODEL=gemini-embedding-001
